  "recovery_cases": [
    {
      "id": "electronic-repair",
      "base_case": "si-pbe-chain",
      "tasks": [
        "scf"
      ],
      "override": {
        "nelm": 1
      },
      "expected": "COMPLETED but rejected electronic convergence; model repair changes only NELM; submit child and accept."
    },
    {
      "id": "ionic-repair",
      "base_case": "si-pbe-chain",
      "tasks": [
        "relax"
      ],
      "override": {
        "nsw": 1
      },
      "expected": "Displaced geometry and NSW=1 produce an ionic limit; repair changes only NSW, not EDIFFG; accept new run."
    },
    {
      "id": "walltime-repair",
      "base_case": "si-pbe-chain",
      "tasks": [
        "scf"
      ],
      "walltime": "00:01:00",
      "expected": "A 75-second pre-solver delay exceeds the initial 1-minute Slurm limit. The recorded repair increases only walltime, retaining the same delayed command and inputs.",
      "injected_delay_seconds": 75,
      "protocol_change": "Use a controlled scheduler timeout instead of relying on material-dependent solver runtime. This does not measure VASP performance."
    },
    {
      "id": "resume-cancel",
      "tasks": [
        "scf"
      ],
      "expected": "Use a dedicated, authorized test job; stop local monitoring only, resume same job, then cancel and confirm sacct. Never cancel unrelated jobs."
    },
    {
      "id": "unknown-failure-refusal",
      "expected": "Retained missing-output/unknown failure produces needs_input, with no new submission."
    }
  ],
  "coverage_note": "HSE/PBE0+SOC compatibility is deliberately tested, not assumed. Combined-regime failures need isolated probes or an explicit supported-scope correction. Other noncollinear/+U/hybrid permutations remain unproven unless recorded separately.",
  "acceptance": [
    "Record source/module/config/input hashes and actual solver version.",
    "Require scheduler COMPLETED plus parser acceptance; distinguish failure from test omission.",
    "Check real method tags, geometry/site propagation, local magnetic moments, U/J order, hybrid path consistency and generated exports.",
    "Use the installed wheel outside the source checkout for at least one full model-to-results case.",
    "Do not mutate original jobs/results; repairs create new runs."
  ]
}
